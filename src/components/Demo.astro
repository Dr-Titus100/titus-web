---
import ScoreRing from "./ScoreRing.astro";
import data from "../data/examples.generated.json";
// Generated by scripts/gen-examples.mjs from the pinned titus_tools.py, so the highlights, labels and
// scores are the script's own output for these two texts.
const { before, after, spans, patterns, beforeScore, beforeTier, afterScore, afterTier, afterPatterns } = data.demo;
---
<div class="demo card reveal" id="demo" data-before={before} data-after={after} data-spans={JSON.stringify(spans)}
  data-score={JSON.stringify({ patterns, beforeScore, beforeTier, afterScore, afterTier, afterPatterns })}>
  <div class="demo-top">
    <span class="demo-pill" id="demo-pill">Draft</span>
    <button class="btn btn-small" id="demo-replay" type="button">Replay</button>
  </div>
  <div class="demo-body">
    <p class="demo-text" id="demo-text">{before}</p>
    <div class="demo-side">
      <ScoreRing id="demo-ring" size={150} />
      <p class="small muted center" id="demo-caption">AI-pattern score</p>
    </div>
  </div>
</div>
<style is:global>
  .demo { padding: clamp(24px, 4vw, 44px); max-width: 980px; margin: 0 auto; }
  .demo-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
  .demo-pill { font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 980px; background: var(--bg-soft); color: var(--ink-soft); transition: background 0.4s, color 0.4s; }
  .demo-pill.is-after { background: rgba(52, 199, 89, 0.15); color: var(--good-on-tint); }
  .demo-body { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: clamp(20px, 4vw, 48px); align-items: center; }
  @media (max-width: 680px) { .demo-body { grid-template-columns: 1fr; justify-items: center; } }
  .demo-text { margin: 0; font-size: clamp(18px, 2.2vw, 24px); line-height: 1.55; letter-spacing: -0.015em; min-height: 7.5em; transition: opacity 0.5s, filter 0.5s, transform 0.5s var(--ease); }
  .demo-text.fade { opacity: 0; filter: blur(8px); transform: translateY(8px); }
  .demo-text mark { color: inherit; border-radius: 4px; background: transparent; box-shadow: inset 0 0 0 transparent; transition: background 0.5s, box-shadow 0.5s; }
  .demo-text mark.on { background: var(--hl-rule); box-shadow: inset 0 -2px 0 var(--hl-rule-line); }
  .demo-text mark.on.v { background: var(--hl-vocab); box-shadow: inset 0 -2px 0 var(--hl-vocab-line); }
  .demo-text mark.on.t { background: var(--hl-tone); box-shadow: inset 0 -2px 0 var(--hl-tone-line); }
</style>
<script>
  import { setRing } from "../scripts/ring";
  import { groupOf } from "../scripts/titus";
  const el = document.getElementById("demo") as HTMLElement | null;
  if (el) {
    const before = el.dataset.before!, after = el.dataset.after!;
    const spans: [number, number, string][] = JSON.parse(el.dataset.spans!);
    const sc = JSON.parse(el.dataset.score!);
    const text = document.getElementById("demo-text")!;
    const pill = document.getElementById("demo-pill")!;
    const caption = document.getElementById("demo-caption")!;
    const cls = (l: string) => ({ vocab: "v", rule: "", story: "t", format: "t", tone: "t" }[groupOf(l)] ?? "t");
    // The script counts offsets in code points, so slice an array of code points.
    const cps = Array.from(before);
    const cut = (a: number, b?: number) => cps.slice(a, b).join("");
    const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" }[c]!));
    // The pattern name shows as the browser's tooltip on hover, as it did before the demo was regenerated.
    const attr = (s: string) => esc(s).replace(/"/g, "&quot;");
    const timers: number[] = [];
    const later = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function play() {
      timers.splice(0).forEach(clearTimeout);
      let html = "", last = 0;
      // Spans can overlap, so each mark starts where the previous one ended.
      [...spans].sort((x, y) => x[0] - y[0]).forEach(([s, e, l], i) => {
        if (e <= last) return;
        const from = Math.max(s, last);
        html += esc(cut(last, from)) + `<mark data-i="${i}" class="${cls(l)}" data-label="${attr(l)}" title="${attr(l)}">${esc(cut(from, e))}</mark>`;
        last = e;
      });
      text.innerHTML = html + esc(cut(last));
      text.classList.remove("fade");
      pill.textContent = "Draft"; pill.classList.remove("is-after");
      caption.textContent = "Scanning for patterns";
      setRing("demo-ring", 0, "none", "Score");
      const step = reduce ? 0 : 260;
      text.querySelectorAll("mark").forEach((m, i) => later(400 + i * step, () => m.classList.add("on")));
      const t1 = 400 + text.querySelectorAll("mark").length * step + 200;
      later(t1, () => { setRing("demo-ring", sc.beforeScore, sc.beforeTier); caption.textContent = `${sc.patterns} patterns found`; });
      later(t1 + (reduce ? 0 : 2600), () => text.classList.add("fade"));
      later(t1 + (reduce ? 0 : 3200), () => {
        text.textContent = after;
        text.classList.remove("fade");
        pill.textContent = "Rewrite"; pill.classList.add("is-after");
        setRing("demo-ring", sc.afterScore, sc.afterTier);
        caption.textContent = sc.afterPatterns ? `Same facts, ${sc.afterPatterns} patterns left` : "Same facts, no patterns left";
      });
    }
    const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { play(); io.disconnect(); } }, { threshold: 0.4 });
    io.observe(el);
    document.getElementById("demo-replay")!.addEventListener("click", play);
  }
</script>
