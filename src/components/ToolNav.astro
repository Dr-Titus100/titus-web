---
import { u } from "../lib/url";
interface Props { current: string }
const { current } = Astro.props;
const items = [
  { key: "overview", href: "/tools/titus-humanizer/", label: "Overview" },
  { key: "checker", href: "/tools/titus-humanizer/checker/", label: "Checker" },
  { key: "rewrite", href: "/tools/titus-humanizer/rewrite/", label: "Rewrite" },
  { key: "any-chatbot", href: "/tools/titus-humanizer/any-chatbot/", label: "Any chatbot" },
  { key: "install", href: "/tools/titus-humanizer/install/", label: "Install" },
];
---
<nav class="subnav" aria-label="Humanizer">
  <div class="wrap wrap-text subnav-inner">
    <a class="subnav-title" href={u("/tools/titus-humanizer/")}>Humanizer</a>
    <div class="subnav-right">
      <button class="subnav-toggle" type="button" aria-expanded="false" aria-controls="subnav-links" aria-label="Open the Humanizer menu">
        <svg width="14" height="8" viewBox="0 0 14 8" aria-hidden="true"><path d="M1 1l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      <ul class="subnav-links" id="subnav-links">
        {items.map((i) => (
          <li><a href={u(i.href)} aria-current={current === i.key ? "page" : undefined}>{i.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</nav>
<script is:inline>
  // On desktop, start the tabs directly under Humanizer in the top bar, so Overview sits below it.
  // When there isn't room for that, or on phones, the tabs stay at the right as the CSS places them.
  (() => {
    const bar = document.currentScript.previousElementSibling;
    const right = bar.querySelector(".subnav-right");
    const align = () => {
      const top = document.querySelector('.nav-links a[href$="/tools/titus-humanizer/"]');
      right.classList.remove("aligned");
      if (!top || matchMedia("(max-width: 734px)").matches) return;
      const inner = bar.querySelector(".subnav-inner").getBoundingClientRect();
      const title = bar.querySelector(".subnav-title").getBoundingClientRect();
      const x = top.getBoundingClientRect().left - inner.left;
      const pad = parseFloat(getComputedStyle(bar.querySelector(".subnav-inner")).paddingRight) || 0;
      if (inner.left + x < title.right + 24 || x + right.offsetWidth > inner.width - pad) return;
      right.style.setProperty("--tabs-x", `${x}px`);
      right.classList.add("aligned");
    };
    align();
    addEventListener("resize", align);
    if (document.fonts) document.fonts.ready.then(align);
  })();
</script>
