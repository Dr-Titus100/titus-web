---
import { u } from "../lib/url";
interface Props { current: string }
const { current } = Astro.props;
const items = [
  { key: "overview", href: "/tools/titus-humanizer/", label: "Overview" },
  { key: "checker", href: "/tools/titus-humanizer/checker/", label: "Checker" },
  { key: "rewrite", href: "/tools/titus-humanizer/rewrite/", label: "Rewrite" },
  { key: "any-chatbot", href: "/tools/titus-humanizer/any-chatbot/", label: "Any chatbot" },
  { key: "install", href: "/tools/titus-humanizer/install/", label: "Install" },
];
---
<nav class="subnav" aria-label="Humanizer">
  <div class="wrap wrap-text subnav-inner">
    <a class="subnav-title" href={u("/tools/titus-humanizer/")}>Humanizer</a>
    <div class="subnav-right">
      <button class="subnav-toggle" type="button" aria-expanded="false" aria-controls="subnav-links" aria-label="Open the Humanizer menu">
        <svg width="14" height="8" viewBox="0 0 14 8" aria-hidden="true"><path d="M1 1l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      <ul class="subnav-links" id="subnav-links">
        {items.map((i) => (
          <li><a href={u(i.href)} aria-current={current === i.key ? "page" : undefined}>{i.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</nav>
