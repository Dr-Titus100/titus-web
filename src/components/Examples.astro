---
const examples = [
  {
    tag: "Announcement",
    before: "In today's fast-paced digital landscape, our new onboarding checklist isn't just a tracker — it's a gateway to a more seamless experience, fostering alignment and driving meaningful impact.",
    after: "The new onboarding checklist shows new hires which setup steps they have finished.",
  },
  {
    tag: "Email",
    before: "I hope this message finds you well! I wanted to reach out to touch base regarding the proposal, which was reviewed by our team last week. It's not just a budget request — it's a roadmap for sustainable growth. Please let me know if you have any questions!",
    after: "Our team reviewed the proposal last week. It sets out the budget we're requesting and what it would cover. I'm happy to walk you through the numbers.",
    report: "AI-pattern score: 0.56 (medium) before, not scored (27 words, needs at least 30) after\nPatterns before: em dash x1, reject-then-assert x1, passive voice (heuristic) x1, chatbot residue x1\nPatterns left after: none\nHidden characters removed: none\nNote: short text, so the score is dampened and less reliable.",
  },
  {
    tag: "Story",
    before: "Elena stood at the window as the rain fell, mirroring the storm inside her. Her chest tightened, ice crawled down her spine, and the scent of wet earth and old memories filled her lungs. She realized, at last, that letting go was not the same as forgetting. It was a way of carrying him with her.",
    after: "Elena stood at the window and watched the rain. She was afraid. She decided she could let him go without forgetting him.",
  },
];
---
<section class="section section-soft" id="examples">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Before and after</p>
      <h2 class="h2">Shorter, plainer and still true.</h2>
      <p class="lead">None of the rewrites add facts. When a draft is vague, the skill writes the plainest honest sentence.</p>
    </div>
    <div class="examples">
      {examples.map((ex, i) => (
        <article class="example reveal" style={`--d:${i * 0.06}s`}>
          <p class="eyebrow">{ex.tag}</p>
          <div class="ba">
            <div class="card ba-before"><div class="ba-label">Before</div><p>{ex.before}</p></div>
            <div class="card ba-after"><div class="ba-label">After</div><p>{ex.after}</p></div>
          </div>
          {ex.report && (
            <details class="ex-report">
              <summary>The report the script printed</summary>
              <pre>{ex.report}</pre>
            </details>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
<style is:global>
  .examples { display: grid; gap: 56px; }
  .example .ba-before p { color: var(--ink-soft); }
  .example.in .ba-before p { text-decoration: line-through; text-decoration-color: rgba(201, 48, 44, 0.45); text-decoration-thickness: 1.5px; transition: text-decoration-color 0.8s 0.6s; }
  .example .ba-after { transform: translateX(24px); opacity: 0; transition: transform 1s var(--ease) 0.35s, opacity 1s var(--ease) 0.35s; }
  .example.in .ba-after { transform: none; opacity: 1; }
  .no-js .example .ba-after { transform: none; opacity: 1; }
  .ex-report { margin-top: 14px; font-size: 14px; color: var(--ink-soft); }
  .ex-report summary { cursor: pointer; }
  @media (prefers-reduced-motion: reduce) { .example .ba-after { transform: none; opacity: 1; } }
</style>
