---
import data from "../data/examples.generated.json";
// The reports are the pinned scoring script's own output, generated by scripts/gen-examples.mjs.
const examples = data.examples;
// The section is light gray unless the page around it needs white to keep sections alternating.
const { soft = true } = Astro.props as { soft?: boolean };
---
<section class={soft ? "section section-soft" : "section"} id="examples">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Before and after</p>
      <h2 class="h2">Each rewrite is shorter and plainer, with the same facts</h2>
      <p class="lead">None of the rewrites add facts. When a draft is vague, the skill writes the plainest honest sentence. Code, file paths, links, emoji and quoted text come through exactly as written.</p>
    </div>
    <div class="examples">
      {examples.map((ex, i) => (
        <article class="example reveal" style={`--d:${i * 0.06}s`}>
          <h3 class="h4 ex-tag">{ex.tag}</h3>
          <div class="ba">
            <div class="card ba-before"><div class="ba-label">Before</div><p>{ex.before}</p></div>
            <div class="card ba-after"><div class="ba-label">After</div><p>{ex.after}</p></div>
          </div>
          {ex.report && (
            <details class="ex-report">
              <summary>The report the scoring script printed</summary>
              <pre>{ex.report}</pre>
            </details>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
<style is:global>
  .examples { display: grid; gap: 56px; }
  .ex-tag { margin: 0 0 16px; }
  .example .ba-before p { color: var(--ink-soft); }
  .example.in .ba-before p { text-decoration: line-through; text-decoration-color: rgba(201, 48, 44, 0.45); text-decoration-thickness: 1.5px; transition: text-decoration-color 0.8s 0.6s; }
  .example .ba-after { transform: translateX(16px); transition: transform 0.6s var(--ease) 0.2s; }
  .example.in .ba-after, .no-js .example .ba-after { transform: none; }
  @media (max-width: 734px) { .example .ba-after { transform: translateY(12px); } }
  .ex-report { margin-top: 14px; font-size: 14px; color: var(--ink-soft); }
  .ex-report summary { cursor: pointer; }
  @media (prefers-reduced-motion: reduce) { .example .ba-after { transform: none; } }
</style>
