---
interface Props { id: string; label?: string; size?: number }
const { id, label = "AI-pattern score", size = 168 } = Astro.props;
---
<div class="ring" id={id} style={`--size:${size}px`} data-tier="none">
  <svg viewBox="0 0 120 120" aria-hidden="true">
    <circle class="ring-track" cx="60" cy="60" r="52" />
    <circle class="ring-fill" cx="60" cy="60" r="52" pathLength="100" />
  </svg>
  <div class="ring-center">
    <span class="ring-value">--</span>
    <span class="ring-tier">{label}</span>
  </div>
</div>
<style is:global>
  .ring { position: relative; width: var(--size); height: var(--size); flex: none; }
  .ring svg { width: 100%; height: 100%; transform: rotate(-90deg); }
  .ring circle { fill: none; stroke-width: 9; }
  .ring-track { stroke: var(--line-soft); }
  .ring-fill { stroke: var(--ink-faint); stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: 100; transition: stroke-dashoffset 1.2s var(--ease), stroke 0.6s; }
  .ring[data-tier="low"] .ring-fill { stroke: var(--good); }
  .ring[data-tier="medium"] .ring-fill { stroke: var(--warn); }
  .ring[data-tier="high"] .ring-fill { stroke: var(--bad); }
  .ring-center { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 0 18%; }
  .ring-value { font-family: var(--font-display); font-size: calc(var(--size) * 0.25); font-weight: 700; letter-spacing: -0.03em; line-height: 1; font-variant-numeric: tabular-nums; }
  .ring-tier { font-size: 12px; color: var(--ink-soft); margin-top: 6px; line-height: 1.2; }
</style>
