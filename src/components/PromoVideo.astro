---
import fs from "node:fs";
import path from "node:path";
import { u } from "../lib/url";

// Captions and the transcript come from one WebVTT file. When the file exists, the video gets a
// captions track and the page gets a "Read the transcript" panel built from the same cues.
const vttPath = path.join(process.cwd(), "public/media/titus-humanizer-promo.en.vtt");
const vtt = fs.existsSync(vttPath) ? fs.readFileSync(vttPath, "utf8") : "";
const transcript = vtt
  .split(/\r?\n\r?\n/)
  .map((block) => block.split(/\r?\n/).filter((l) => l && !/^WEBVTT/.test(l) && !/-->/.test(l) && !/^\d+$/.test(l) && !/^NOTE\b/.test(l)).join(" "))
  .map((t) => t.replace(/<[^>]+>/g, "").trim())
  .filter(Boolean);
---
<div class="video-stage reveal">
  <div class="video-frame" data-scroll-scale>
    <video controls playsinline preload="metadata" poster={u("/media/titus-humanizer-promo-poster.jpg")} aria-label="titus-humanizer tour video">
      <source src={u("/media/titus-humanizer-promo.mp4")} type="video/mp4" />
      {vtt && <track kind="captions" srclang="en" label="English" src={u("/media/titus-humanizer-promo.en.vtt")} default />}
      Your browser can't play this video. <a href={u("/media/titus-humanizer-promo.mp4")}>Download it</a> instead.
    </video>
  </div>
  {transcript.length > 0 && (
    <details class="transcript">
      <summary>Read the transcript</summary>
      <div class="transcript-body">
        {transcript.map((t) => <p>{t}</p>)}
      </div>
    </details>
  )}
</div>

<style>
  .transcript { max-width: 760px; margin: 20px auto 0; font-size: 15px; }
  .transcript summary { cursor: pointer; color: var(--link); text-align: center; list-style: none; padding: 8px 0; }
  .transcript summary::-webkit-details-marker { display: none; }
  .transcript summary::after { content: " ›"; }
  .transcript[open] summary::after { content: " ⌄"; }
  .transcript-body { text-align: left; color: inherit; line-height: 1.6; }
  .transcript-body p { margin: 0 0 10px; }
  :global(.section-dark) .transcript summary { color: #2997ff; }
</style>
