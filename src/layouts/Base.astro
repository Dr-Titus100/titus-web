---
import interLatin from "../fonts/inter-latin-wght-normal.woff2?url";
import "../styles/global.css";
import { u } from "../lib/url";
import { links as profileLinks } from "../data/profile";

interface Props {
  title: string;
  // The whole browser-tab title, when "Titus Nyarko Nde: <title>" doesn't fit, as on the titus-humanizer pages.
  fullTitle?: string;
  description?: string;
  current?: string;
  // The link-preview image, a path under public/ (1200 x 630). See scripts/make-share-images.mjs.
  image?: string;
  imageAlt?: string;
  type?: "website" | "article" | "profile";
  // Structured data for search engines, written into the page as JSON-LD.
  jsonLd?: Record<string, unknown>;
}
const {
  title,
  description = "Skills, plugins and writing by Titus Nyarko Nde.",
  current = "",
  image = "/og/site.png",
  imageAlt = "Titus Nyarko Nde, data scientist",
  type = "website",
  jsonLd,
} = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(u(image), Astro.site).href;
// "</" can't appear inside a script element, so it's escaped in the JSON.
const ld = jsonLd ? JSON.stringify({ "@context": "https://schema.org", ...jsonLd }).replace(/</g, "\\u003c") : "";
const fullTitle = Astro.props.fullTitle ?? (title === "Titus Nyarko Nde" ? title : `Titus Nyarko Nde: ${title}`);
const links = [
  { href: "/tools/", label: "Tools", key: "tools" },
  { href: "/tools/titus-humanizer/", label: "Humanizer", key: "humanizer" },
  { href: "/blog/", label: "Blog", key: "blog" },
  { href: "/experience/", label: "Experience", key: "experience" },
  { href: "/about/", label: "About", key: "about" },
];
const year = new Date().getFullYear();
const footerCols = [
  { title: "Humanizer", links: [
    { href: u("/tools/titus-humanizer/"), label: "Overview" },
    { href: u("/tools/titus-humanizer/checker/"), label: "Checker" },
    { href: u("/tools/titus-humanizer/rewrite/"), label: "Rewrite" },
    { href: u("/tools/titus-humanizer/any-chatbot/"), label: "Any chatbot" },
    { href: u("/tools/titus-humanizer/install/"), label: "Install" },
  ] },
  { title: "Work and writing", links: [
    { href: u("/tools/"), label: "Tools" },
    { href: u("/blog/"), label: "Blog" },
    { href: u("/experience/"), label: "Experience" },
  ] },
  { title: "About Titus", links: [
    { href: u("/about/"), label: "About" },
    { href: u("/about/#contact"), label: "Contact" },
  ] },
  { title: "Elsewhere", links: [
    { href: profileLinks.github, label: "GitHub" },
    { href: profileLinks.linkedin, label: "LinkedIn" },
    { href: profileLinks.scholar, label: "Google Scholar" },
    { href: profileLinks.orcid, label: "ORCID" },
  ] },
];
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Titus Nyarko Nde" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={u("/favicon.ico")} sizes="32x32" />
    <link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={u("/apple-touch-icon.png")} />
    <link rel="manifest" href={u("/site.webmanifest")} />
    <link rel="alternate" type="application/rss+xml" title="Titus Nyarko Nde: Blog" href={u("/rss.xml")} />
    <link rel="canonical" href={pageUrl} />
    {ld && <script type="application/ld+json" set:html={ld} />}
    <script is:inline>document.documentElement.classList.remove("no-js");</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="nav" id="nav">
      <nav class="wrap nav-inner" aria-label="Site">
        <a class="brand" href={u("/")} aria-label="Titus Nyarko Nde, home" aria-current={current === "home" ? "page" : undefined}>TN</a>
        <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links"><span></span><span></span></button>
        <ul class="nav-links" id="nav-links">
          {links.map((l) => (
            <li><a href={u(l.href)} aria-current={current === l.key ? "page" : undefined}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>
    <slot name="subnav" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap">
        <p class="footer-note">The Checker runs in your browser. Rewrites go only to the AI provider you choose, and contact messages go through Web3Forms. The <a href={u("/privacy/")}>Privacy page</a> has the details.</p>
        <nav class="footer-cols" id="site-map" aria-label="Site map">
          {footerCols.map((col) => (
            <details class="footer-col" open>
              <summary>{col.title}</summary>
              <ul>
                {col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
              </ul>
            </details>
          ))}
        </nav>
        <div class="footer-bottom">
          <span>Copyright © {year} Titus Nyarko Nde. titus-humanizer is MIT licensed.</span>
          <span class="footer-legal"><a href={u("/privacy/")}>Privacy</a><a href={u("/terms/")}>Terms</a><a href={u("/site-map/")}>Site map</a></span>
        </div>
      </div>
    </footer>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <script>
      import { initSite } from "../scripts/site";
      initSite();
    </script>
  </body>
</html>
