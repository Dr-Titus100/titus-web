---
import Base from "../layouts/Base.astro";
import Demo from "../components/Demo.astro";
import PromoVideo from "../components/PromoVideo.astro";
import { u } from "../lib/url";
---
<Base title="Titus Nyarko Nde" current="home" description="Skills and plugins by Titus Nyarko Nde, starting with titus-humanizer, which makes writing read like a careful person wrote it.">
  <section class="hero home-hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="wrap">
      <p class="eyebrow">titus-humanizer</p>
      <h1 class="display" data-rise>Writing that sounds like you.</h1>
      <p class="lead">Paste a draft and see which phrases read as machine-made. Then get it back in plain words, with every fact, number and name kept.</p>
      <div class="btn-row">
        <a class="btn" href={u("/tools/titus-humanizer/checker/")}>Check your text free</a>
        <a class="btn btn-ghost" href={u("/tools/titus-humanizer/")}>Learn more</a>
      </div>
    </div>
  </section>

  <section class="section-tight" style="padding-top: 8px">
    <div class="wrap">
      <Demo />
      <p class="small muted center" style="margin-top: 16px">Real scores from titus_tools.py. The rewrite keeps the 12 steps, the two weeks and who uses the list.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <h2 class="h2">Use it four ways, with no sign-up.</h2>
        <p class="lead">You don't need Claude or ChatGPT to use it.</p>
      </div>
      <div class="grid grid-2">
        <a class="card tile reveal" href={u("/tools/titus-humanizer/checker/")}>
          <span class="tile-icon" style="background: linear-gradient(135deg,#34c759,#0a8f3c)">✓</span>
          <h3 class="h3">Check any text</h3>
          <p>Get the 0 to 1 score, every pattern marked in place and the hidden characters removed. It runs in your browser and costs nothing.</p>
          <span class="link-arrow">Open the checker</span>
        </a>
        <a class="card tile reveal" style="--d: 0.08s" href={u("/tools/titus-humanizer/rewrite/")}>
          <span class="tile-icon" style="background: linear-gradient(135deg,#0071e3,#5e5ce6)">✎</span>
          <h3 class="h3">Rewrite with your key</h3>
          <p>Use a Gemini, Claude or OpenAI key. Google's free tier works, so a rewrite can cost you nothing.</p>
          <span class="link-arrow">Rewrite a draft</span>
        </a>
        <a class="card tile reveal" href={u("/tools/titus-humanizer/any-chatbot/")}>
          <span class="tile-icon" style="background: linear-gradient(135deg,#ff9f0a,#ff375f)">⧉</span>
          <h3 class="h3">Use any chatbot</h3>
          <p>Copy the rulebook into Gemini, Copilot, Perplexity or whatever you already use.</p>
          <span class="link-arrow">Get the rules</span>
        </a>
        <a class="card tile reveal" style="--d: 0.08s" href={u("/tools/titus-humanizer/install/")}>
          <span class="tile-icon" style="background: linear-gradient(135deg,#1d1d1f,#636366)">↓</span>
          <h3 class="h3">Install it</h3>
          <p>Add the skill to Claude, ChatGPT, Claude Code or Codex. It loads whenever you ask for a rewrite.</p>
          <span class="link-arrow">Install</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Watch</p>
        <h2 class="h2">See every feature in two and a half minutes.</h2>
      </div>
      <PromoVideo />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <h2 class="h2">How it works</h2>
        <p class="lead">The skill cleans the text, checks it at three levels, fixes what it finds and then measures the result.</p>
      </div>
      <div class="grid grid-3 how">
        <div class="card reveal"><span class="how-n">1</span><h3 class="h3">Clean</h3><p class="muted">It removes characters you can't see, such as zero-width spaces and look-alike letters, and leaves emoji, other alphabets and code alone.</p></div>
        <div class="card reveal" style="--d: 0.08s"><span class="how-n">2</span><h3 class="h3">Rewrite</h3><p class="muted">Seven hard rules, five kinds of weak wording and the patterns AI stories share. It keeps every fact, number and name.</p></div>
        <div class="card reveal" style="--d: 0.16s"><span class="how-n">3</span><h3 class="h3">Measure</h3><p class="muted">It scores the original and the rewrite from 0 to 1, and takes another pass if the rewrite still scores high.</p></div>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="wrap center">
      <div class="reveal">
        <p class="eyebrow">More on the way</p>
        <h2 class="h2">New skills and plugins land here.</h2>
        <p class="lead" style="max-width: 680px; margin-left: auto; margin-right: auto">This site is the home for the tools Titus builds. Each one gets its own page as it ships.</p>
        <div class="btn-row center" style="margin-top: 28px">
          <a class="btn" href={u("/tools/")}>See all tools</a>
          <a class="btn btn-ghost" href={u("/about/")}>About Titus</a>
        </div>
      </div>
    </div>
  </section>
</Base>
<style>
  .home-hero { padding-top: clamp(80px, 13vw, 160px); }
  .how .card { display: flex; flex-direction: column; gap: 10px; }
  .how p { margin: 0; }
  .how-n { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; background: var(--ink); color: var(--bg); margin-bottom: 6px; }
</style>
