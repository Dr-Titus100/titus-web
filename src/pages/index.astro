---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { u } from "../lib/url";
const posts = (await getCollection("blog", (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---
<Base title="Titus Nyarko Nde" current="home" description="AI skills, plugins and writing by Titus Nyarko Nde, a data scientist with a Ph.D. in Computing. Every tool has a free way to try it on this site.">
  <section class="hero home-hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="wrap">
      <p class="eyebrow">Titus Nyarko Nde</p>
      <h1 class="display" data-rise>AI tools, writing and my work in data science</h1>
      <p class="lead">I'm a data scientist with a Ph.D. in Computing. This site holds the AI tools I build, what I write about AI and machine learning, and the work I've done so far.</p>
      <div class="btn-row">
        <a class="btn btn-ghost" href="#explore">Explore the site</a>
        <a class="btn btn-ghost" href={u("/about/")}>About me</a>
      </div>
    </div>
  </section>

  <section class="section-tight" id="explore" style="padding-top: 8px">
    <div class="wrap">
      <div class="section-head reveal">
        <h2 class="h2">What you'll find here</h2>
      </div>
      <div class="grid grid-3">
        <a class="card tile reveal" href={u("/tools/")}>
          <span class="tile-icon" style="background: linear-gradient(135deg,#0071e3,#5e5ce6)">⚙</span>
          <h3 class="h3">Tools</h3>
          <p>Skills and plugins I build for AI assistants. Each one is free to try in your browser, with no sign-up.</p>
          <span class="link-arrow">See the tools</span>
        </a>
        <a class="card tile reveal" style="--d: 0.08s" href={u("/blog/")}>
          <span class="tile-icon" style="background: linear-gradient(135deg,#ff9f0a,#ff375f)">✎</span>
          <h3 class="h3">Blog</h3>
          <p>What I write about AI, data science and building tools.</p>
          <span class="link-arrow">Read the blog</span>
        </a>
        <a class="card tile reveal" style="--d: 0.16s" href={u("/experience/")}>
          <span class="tile-icon" style="background: linear-gradient(135deg,#34c759,#0a8f3c)">★</span>
          <h3 class="h3">Experience</h3>
          <p>My work in AI evaluation, banking and research, with the education and skills behind it.</p>
          <span class="link-arrow">See my experience</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="wrap">
      <div class="section-head reveal">
        <h2 class="h2">From the blog</h2>
      </div>
      {posts.length === 0 ? (
        <div class="card center reveal empty-blog">
          <p class="lead" style="margin: 0">The first posts are coming soon. They will cover AI evaluation, machine learning and how the tools on this site work.</p>
        </div>
      ) : (
        <div class="grid grid-3">
          {posts.map((p, i) => (
            <a class="card tile reveal" style={`--d: ${i * 0.06}s`} href={u(`/blog/${p.id}/`)}>
              <p class="small muted" style="margin: 0">{fmt(p.data.date)}</p>
              <h3 class="h3">{p.data.title}</h3>
              <p>{p.data.description}</p>
            </a>
          ))}
        </div>
      )}
      <div class="btn-row center reveal" style="margin-top: 28px">
        <a class="btn btn-ghost" href={u("/blog/")}>All posts</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap wrap-narrow">
      <div class="home-about reveal">
        <img class="home-portrait" src={u("/images/titus.jpg")} alt="Titus Nyarko Nde" width="140" height="140" loading="lazy" />
        <div>
          <h2 class="h2" style="margin-top: 0">About me</h2>
          <p class="lead" style="margin: 0">I'm a data scientist with a Ph.D. in Computing from Boise State University. I've built credit and churn models for lenders, measured uncertainty in scientific models, and graded and written training data for large language models.</p>
          <div class="btn-row" style="margin-top: 22px">
            <a class="btn btn-ghost" href={u("/experience/")}>Experience</a>
            <a class="btn btn-ghost" href={u("/about/")}>About</a>
            <a class="btn btn-ghost" href={u("/about/#contact")}>Contact me</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
<style>
  .home-hero { padding-top: clamp(80px, 13vw, 160px); }
  #explore { scroll-margin-top: 64px; }
  .empty-blog { min-height: 0; padding: 36px 28px; }
  .home-about { display: grid; grid-template-columns: 140px 1fr; gap: 36px; align-items: center; }
  .home-portrait { width: 140px; height: 140px; border-radius: 50%; object-fit: cover; border: 4px solid var(--bg); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 55%, #7c3aed), 0 14px 40px rgba(0, 113, 227, 0.2); }
  @media (max-width: 640px) {
    .home-about { grid-template-columns: 1fr; text-align: center; justify-items: center; }
    .home-about .btn-row { justify-content: center; }
  }
</style>
