---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { u } from "../lib/url";
import { tools } from "../data/tools";
const posts = (await getCollection("blog", (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---
<Base title="Titus Nyarko Nde" current="home" description="AI skills, plugins and writing by Titus Nyarko Nde, a data scientist with a Ph.D. in Computing. Every tool has a free way to try it on this site.">
  <section class="hero home-hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="wrap">
      <p class="eyebrow">Titus Nyarko Nde</p>
      <h1 class="display" data-rise>AI skills and tools you can try for free</h1>
      <p class="lead">I build skills and plugins for Claude, ChatGPT and other assistants. Each one has a page here where you can try it in your browser, use it in the chatbot you already have, or install it.</p>
      <div class="btn-row">
        <a class="btn btn-ghost" href="#tools">See the tools</a>
        <a class="btn btn-ghost" href={u("/about/")}>About me</a>
      </div>
    </div>
  </section>

  <section class="section-tight" id="tools" style="padding-top: 8px">
    <div class="wrap">
      <div class="section-head reveal">
        <h2 class="h2">Tools</h2>
        <p class="lead">Every tool is free to try here, with no sign-up.</p>
      </div>
      <div class="grid grid-2 home-tools">
        {tools.map((t) => (
          <div class="card tool-card reveal">
            <a class="tool-main" href={u(t.href)}>
              <span class="tile-icon" style={`background:${t.gradient}`}>T</span>
              <p class="small muted" style="margin: 0">{t.kind}, {t.version}</p>
              <h3 class="h3">{t.name}</h3>
              <p>{t.blurb}</p>
              <span class="link-arrow">Overview</span>
            </a>
            <ul class="tool-links">
              {t.links.map((l) => <li><a href={u(l.href)}>{l.label}</a></li>)}
            </ul>
          </div>
        ))}
        <div class="card tile soon reveal" style="--d: 0.08s">
          <span class="tile-icon" style="background: var(--line)">+</span>
          <h3 class="h3">More on the way</h3>
          <p>New skills and plugins will show up here as they ship, each with its own page.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="wrap">
      <div class="section-head reveal">
        <h2 class="h2">From the blog</h2>
      </div>
      {posts.length === 0 ? (
        <div class="card center reveal empty-blog">
          <p class="lead" style="margin: 0">The first posts are coming soon. They will cover AI evaluation, machine learning and how the tools on this site work.</p>
        </div>
      ) : (
        <div class="grid grid-3">
          {posts.map((p, i) => (
            <a class="card tile reveal" style={`--d: ${i * 0.06}s`} href={u(`/blog/${p.id}/`)}>
              <p class="small muted" style="margin: 0">{fmt(p.data.date)}</p>
              <h3 class="h3">{p.data.title}</h3>
              <p>{p.data.description}</p>
            </a>
          ))}
        </div>
      )}
      <div class="btn-row center reveal" style="margin-top: 28px">
        <a class="btn btn-ghost" href={u("/blog/")}>All posts</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap wrap-narrow">
      <div class="home-about reveal">
        <img class="home-portrait" src={u("/images/titus.jpg")} alt="Titus Nyarko Nde" width="140" height="140" loading="lazy" />
        <div>
          <h2 class="h2" style="margin-top: 0">About me</h2>
          <p class="lead" style="margin: 0">I'm a data scientist with a Ph.D. in Computing from Boise State University. I've built credit and churn models for lenders, measured uncertainty in scientific models, and graded and written training data for large language models.</p>
          <div class="btn-row" style="margin-top: 22px">
            <a class="btn btn-ghost" href={u("/experience/")}>Experience</a>
            <a class="btn btn-ghost" href={u("/about/")}>About</a>
            <a class="btn btn-ghost" href={u("/about/#contact")}>Contact me</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
<style>
  .home-hero { padding-top: clamp(80px, 13vw, 160px); }
  #tools { scroll-margin-top: 64px; }
  .tool-card { display: flex; flex-direction: column; gap: 18px; }
  .tool-main { display: flex; flex-direction: column; gap: 10px; color: inherit; text-decoration: none; }
  .tool-main:hover { text-decoration: none; }
  .tool-main h3, .tool-main p { margin: 0; }
  .tool-main .tile-icon { width: 48px; height: 48px; border-radius: 14px; display: grid; place-items: center; font-size: 24px; color: #fff; margin-bottom: 8px; align-self: flex-start; }
  .tool-links { list-style: none; margin: 0; padding: 16px 0 0; border-top: 1px solid var(--line-soft); display: flex; flex-wrap: wrap; gap: 8px; }
  .tool-links a { display: inline-block; font-size: 14px; padding: 5px 12px; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--line); color: var(--ink); text-decoration: none; }
  .tool-links a:hover { color: var(--link); box-shadow: inset 0 0 0 1px var(--link); }
  .soon { box-shadow: none; border: 1px dashed var(--line); background: transparent; }
  .empty-blog { min-height: 0; padding: 36px 28px; }
  .home-about { display: grid; grid-template-columns: 140px 1fr; gap: 36px; align-items: center; }
  .home-portrait { width: 140px; height: 140px; border-radius: 50%; object-fit: cover; border: 4px solid var(--bg); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 55%, #7c3aed), 0 14px 40px rgba(0, 113, 227, 0.2); }
  @media (max-width: 640px) {
    .home-about { grid-template-columns: 1fr; text-align: center; justify-items: center; }
    .home-about .btn-row { justify-content: center; }
  }
</style>
