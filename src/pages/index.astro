---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { u } from "../lib/url";
import { links } from "../data/profile";
import skills from "../data/skills.generated.json";
const skill = skills["titus-humanizer"];
const latest = (await getCollection("blog", (p) => !p.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---
<Base title="Titus Nyarko Nde" current="home" description="Titus Nyarko Nde is a data scientist with a Ph.D. in Computing. He builds machine learning models, measures how far to trust them, and makes tools that help people write clearly with AI.">
  <section class="home-hero">
    <div class="wrap wrap-text home-hero-grid">
      <img class="home-portrait" src={u("/images/titus.jpg")} alt="Titus Nyarko Nde" width="300" height="300" />
      <div class="home-hero-text">
        <p class="eyebrow">Data scientist</p>
        <h1 class="display">Titus Nyarko Nde</h1>
        <p class="home-intro">I build machine learning models, work out how far to trust their answers, and make tools that help people write clearly with AI.</p>
        <div class="btn-row">
          <a class="btn" href={u("/about/#contact")}>Contact me</a>
          <a class="link-arrow" href="#work">See my work</a>
        </div>
      </div>
    </div>
    <dl class="wrap wrap-text home-facts">
      <div><dt>Ph.D. in Computing</dt><dd>Boise State University, 2026</dd></div>
      <div><dt>100+ citations</dt><dd>My credit-scoring paper in Risks. <a href={links.scholar}>Google Scholar</a>, as of November 2026</dd></div>
      <div><dt>titus-humanizer</dt><dd>An open-source writing skill, {skill.version}</dd></div>
    </dl>
  </section>

  <section class="section section-soft" id="work">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">titus-humanizer</p>
        <h2 class="h2">Plain rewrites that keep every fact</h2>
        <p class="lead">Check any text for AI-writing patterns in your browser, then rewrite it with the assistant you already use.</p>
        <div class="btn-row center home-actions">
          <a class="btn" href={u("/tools/titus-humanizer/checker/")}>Try the Checker</a>
          <a class="link-arrow" href={u("/tools/titus-humanizer/")}>Learn more</a>
        </div>
      </div>
      <figure class="shot reveal">
        <picture>
          <source srcset={u("/images/checker-light.webp")} type="image/webp" />
          <img src={u("/images/checker-light.jpg")} alt="The Checker scoring a sample email 0.80, high, with each AI-writing pattern highlighted in the text" width="1152" height="770" loading="lazy" decoding="async" />
        </picture>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid grid-2">
        <a class="card tile tile-tall reveal" href={u("/experience/")}>
          <p class="tile-eyebrow">Experience</p>
          <h2 class="h-tile">AI evaluation, research and banking</h2>
          <p>Credit and churn models for lenders, uncertainty in scientific models at Boise State and Berkeley Lab, and grading for large language models.</p>
          <span class="link-arrow">See my experience</span>
        </a>
        {latest ? (
          <a class="card tile tile-tall reveal" style="--d: 0.06s" href={u(`/blog/${latest.id}/`)}>
            <p class="tile-eyebrow">From the blog</p>
            <h2 class="h-tile">{latest.data.title}</h2>
            <p class="small"><time datetime={latest.data.date.toISOString().slice(0, 10)}>{fmt(latest.data.date)}</time>{latest.data.fiction && <span class="fiction-tag">Fiction</span>}</p>
            <p>{latest.data.description}</p>
            <span class="link-arrow">{latest.data.fiction ? "Read the story" : "Read the post"}</span>
          </a>
        ) : (
          <a class="card tile tile-tall reveal" style="--d: 0.06s" href={u("/blog/")}>
            <p class="tile-eyebrow">Blog</p>
            <h2 class="h-tile">Writing on AI and data science</h2>
            <p>The first posts are coming soon.</p>
            <span class="link-arrow">Go to the blog</span>
          </a>
        )}
      </div>
    </div>
  </section>
</Base>
<style>
  .home-hero { padding: 120px 0 96px; }
  .home-hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 64px; align-items: center; }
  .home-hero-text { display: flex; flex-direction: column; gap: 16px; }
  .home-hero-text .eyebrow, .home-hero-text .display { margin: 0; }
  .home-hero-text .btn-row { margin-top: 16px; }
  .home-intro { margin: 0; font-size: 24px; line-height: 1.4; }
  .home-portrait { grid-column: 2; grid-row: 1; width: 300px; height: 300px; border-radius: 50%; object-fit: cover; }
  .home-facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin: 80px auto 0; }
  .home-facts div { border-top: 1px solid var(--line); padding-top: 16px; display: flex; flex-direction: column; gap: 8px; }
  .home-facts dt { font-size: 32px; line-height: 1.12; font-weight: 600; letter-spacing: -0.01em; }
  .home-facts dd { margin: 0; font-size: 14px; color: var(--ink-soft); }
  .home-actions { margin-top: 24px; }
  .shot { margin: 0 auto; max-width: 1000px; padding: 20px; border-radius: var(--radius-lg); background: var(--bg-raised); border: 1px solid var(--line-soft); }
  .shot img { width: 100%; height: auto; border-radius: 14px; }
  .tile-eyebrow { font-size: 17px; font-weight: 600; }
  @media (max-width: 1068px) {
    .home-hero-grid { grid-template-columns: minmax(0, 1fr) 240px; gap: 40px; }
    .home-portrait { width: 240px; height: 240px; }
  }
  @media (max-width: 734px) {
    .home-hero { padding: 48px 0 64px; text-align: center; }
    .home-hero-grid { grid-template-columns: 1fr; gap: 24px; justify-items: center; }
    .home-portrait { grid-column: auto; width: 168px; height: 168px; }
    .home-hero-text { align-items: center; }
    .home-intro { font-size: 21px; }
    .home-hero-text .btn-row { flex-direction: column; row-gap: 4px; }
    .home-facts { grid-template-columns: 1fr; gap: 0; margin-top: 40px; text-align: left; }
    .home-facts div { padding: 16px 0; gap: 4px; }
    .home-facts div:last-child { border-bottom: 1px solid var(--line); }
    .home-facts dt { font-size: 24px; }
    .shot { padding: 10px; border-radius: 20px; }
    .shot img { border-radius: 12px; }
    .tile-eyebrow { font-size: 14px; }
  }
</style>
