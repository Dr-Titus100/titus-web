---
import Base from "../../../layouts/Base.astro";
import ToolNav from "../../../components/ToolNav.astro";
import ScoreRing from "../../../components/ScoreRing.astro";
import { u } from "../../../lib/url";
import skills from "../../../data/skills.generated.json";
const skill = skills["titus-humanizer"];
---
<Base title="Checker" current="humanizer" image="/og/titus-humanizer.png" imageAlt="The titus-humanizer Checker scoring a sample text 0.80, high, with the patterns it found" description="Paste text to see its AI-pattern score, the patterns highlighted in place and the hidden characters removed. Quoted text is left out of the score. It runs the titus-humanizer scoring script in your browser.">
  <ToolNav slot="subnav" current="checker" />

  <section class="hero" style="padding-bottom: 32px">
    <div class="wrap wrap-narrow">
      <p class="eyebrow">Checker</p>
      <h1 class="h1" data-rise>Which phrases sound machine-made?</h1>
      <p class="lead">Paste any text. The checker scores it from 0 to 1, marks each pattern where it appears and removes hidden characters. Quoted text belongs to the person quoted, so the checker leaves it out of the score. It uses the same scoring script as titus-humanizer {skill.version}, and it runs inside your browser.</p>
    </div>
  </section>

  <section class="section-tight" style="padding-top: 0">
    <div class="wrap">
      <div class="card checker-card reveal">
        <div class="checker-top">
          <label for="input">Your text</label>
          <span class="status" id="status" data-state="idle"><span class="dot"></span><span class="status-text" id="status-text">The first check downloads Python, about 12 MB</span></span>
        </div>
        <div class="load" id="load" hidden>
          <progress id="load-bar" max="1" value="0" aria-labelledby="load-text"></progress>
          <span class="small muted" id="load-text"></span>
        </div>
        <textarea id="input" spellcheck="false" placeholder="Paste an email, an essay, a cover letter or a story here."></textarea>
        <div class="checker-actions">
          <div class="btn-row">
            <button class="btn btn-ghost" id="run" type="button" aria-describedby="status-text">Check text</button>
            <button class="btn btn-ghost" id="sample" type="button">Try a sample</button>
            <button class="btn btn-ghost" id="clear" type="button">Clear</button>
          </div>
          <span class="small muted" id="count">0 words</span>
        </div>
        <div class="notice" style="margin-top: 18px">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1a3 3 0 0 0-3 3v2H4a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1h-1V4a3 3 0 0 0-3-3Zm-1.5 3a1.5 1.5 0 0 1 3 0v2h-3V4Z"/></svg>
          <span>Your text stays on your device. The website keeps no copies, so no one else has access to your data.</span>
        </div>
      </div>

      <p class="sr-only" id="announce" role="status" aria-live="polite" aria-atomic="true"></p>
      <div class="results" id="results" hidden>
        <div class="grid results-grid">
          <div class="card score-card">
            <ScoreRing id="ring" />
            <dl class="checker-stats">
              <div><dt>Words</dt><dd id="s-words">0</dd></div>
              <div><dt>Sentences</dt><dd id="s-sents">0</dd></div>
              <div><dt>Patterns per 100 words</dt><dd id="s-density">--</dd></div>
              <div><dt>Hidden characters</dt><dd id="s-hidden">0</dd></div>
            </dl>
            <p class="small muted" id="s-note"></p>
          </div>
          <div class="card">
            <h2 class="h3">Patterns found</h2>
            <ul class="patterns" id="patterns"></ul>
            <p class="small muted summary-line" id="quote-summary"></p>
          <p class="small muted summary-line" id="hidden-summary"></p>
          </div>
        </div>

        <div class="card view-card">
          <div class="view-head">
            <div class="segmented" role="tablist" aria-label="View">
              <button role="tab" type="button" id="tab-patterns" aria-controls="view" aria-selected="true" tabindex="0" data-view="patterns">Highlighted patterns</button>
              <button role="tab" type="button" id="tab-hidden" aria-controls="view" aria-selected="false" tabindex="-1" data-view="hidden">Hidden characters</button>
              <button role="tab" type="button" id="tab-cleaned" aria-controls="view" aria-selected="false" tabindex="-1" data-view="cleaned">Cleaned text</button>
            </div>
            <button class="btn btn-small btn-ghost" id="copy-clean" type="button">Copy cleaned text</button>
          </div>
          <div class="legend" id="legend">
            <span><i class="hl-rule"></i>Hard rule</span>
            <span><i class="hl-tone"></i>Substance and tone</span>
            <span><i class="hl-vocab"></i>Vocabulary</span>
            <span><i class="hl-format"></i>Formatting</span>
            <span><i class="hl-story"></i>Story pattern</span>
            <span><i class="hl-quote"></i>Quoted text, not scored</span>
          </div>
          <div class="view" id="view" role="tabpanel" aria-labelledby="tab-patterns" tabindex="0"></div>
          <p class="small muted" id="view-note"></p>
        </div>

        <div class="next reveal">
          <h2 class="h2">Want it rewritten?</h2>
          <p class="lead">Use your own Claude, OpenAI or Gemini key on this site, or paste the rules into any chatbot you already use.</p>
          <div class="btn-row center" style="margin-top: 24px">
            <a class="btn btn-ghost" href={u("/tools/titus-humanizer/rewrite/")}>Rewrite with your key</a>
            <a class="btn btn-ghost" href={u("/tools/titus-humanizer/any-chatbot/")}>Use any chatbot</a>
          </div>
        </div>
      </div>

      <p class="small muted center" style="margin-top: 40px; max-width: 680px; margin-left: auto; margin-right: auto">
        The score counts the writing patterns titus-humanizer targets, so a lower score means plainer, better writing. It isn't the output of GPTZero, Turnitin or any other detector, and a low score doesn't prove a person wrote the text.
      </p>
    </div>
  </section>
</Base>

<style is:global>
  .checker-card { padding: 28px; }
  .checker-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }
  .checker-top label { margin: 0; }
  .checker-actions { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 16px; }
  #input { min-height: 280px; }
  .status { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; color: var(--ink-soft); }
  .status .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--warn); animation: pulse 1.2s ease-in-out infinite; }
  .status[data-state="ready"] .dot { background: var(--good); animation: none; }
  .status[data-state="idle"] .dot { background: var(--ink-faint); animation: none; }
  .load { display: flex; align-items: center; gap: 12px; margin: 6px 0 10px; }
  .load progress { flex: 1; height: 6px; appearance: none; border: 0; border-radius: 3px; background: var(--line-soft); overflow: hidden; }
  .load progress::-webkit-progress-bar { background: var(--line-soft); }
  .load progress::-webkit-progress-value { background: var(--accent); transition: width 0.2s; }
  .load progress::-moz-progress-bar { background: var(--accent); }
  .status[data-state="failed"] .dot { background: var(--bad); animation: none; }
  @keyframes pulse { 50% { opacity: 0.3; transform: scale(0.8); } }
  .results { margin-top: 28px; animation: resultsIn 0.8s var(--ease); }
  .results-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); margin-bottom: 20px; }
  @media (max-width: 820px) { .results-grid { grid-template-columns: 1fr; } }
  .score-card { display: flex; flex-direction: column; align-items: center; gap: 22px; }
  .checker-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 24px; margin: 0; width: 100%; }
  .checker-stats div { border-top: 1px solid var(--line-soft); padding-top: 10px; }
  .checker-stats dt { font-size: 12px; color: var(--ink-soft); }
  .checker-stats dd { margin: 2px 0 0; font-size: 22px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .patterns { list-style: none; padding: 0; margin: 16px 0; }
  .patterns li { display: flex; gap: 12px; align-items: baseline; padding: 10px 0; border-bottom: 1px solid var(--line-soft); opacity: 0; transform: translateX(-10px); animation: itemIn 0.5s var(--ease) forwards; }
  @keyframes itemIn { to { opacity: 1; transform: none; } }
  .patterns .chip { flex: none; width: 10px; height: 10px; border-radius: 3px; transform: translateY(1px); }
  .patterns .name { font-weight: 600; }
  .patterns .count { margin-left: auto; color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .patterns .eg { display: block; font-size: 14px; color: var(--ink-soft); font-weight: 400; }
  .patterns .empty-row { color: var(--good); font-weight: 600; }
  .view-card { padding: 24px 28px; }
  .view-head { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; align-items: center; }
  .legend { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 12px; color: var(--ink-soft); margin: 16px 0 4px; }
  .legend i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 6px; vertical-align: -1px; }
  .view { white-space: pre-wrap; word-wrap: break-word; font-size: 17px; line-height: 1.7; margin-top: 14px; max-height: 560px; overflow: auto; padding: 4px 2px; }
  .hl-rule { background: var(--hl-rule); --line: var(--hl-rule-line); }
  .hl-tone { background: var(--hl-tone); --line: var(--hl-tone-line); }
  .hl-vocab { background: var(--hl-vocab); --line: var(--hl-vocab-line); }
  .hl-format { background: var(--hl-format); --line: var(--hl-format-line); }
  .hl-story { background: var(--hl-story); --line: var(--hl-story-line); }
  .legend .hl-rule { background: var(--hl-rule-line); } .legend .hl-tone { background: var(--hl-tone-line); }
  .legend .hl-vocab { background: var(--hl-vocab-line); } .legend .hl-format { background: var(--hl-format-line); }
  .legend .hl-story { background: var(--hl-story-line); }
  /* Quoted text is shown, but in a quiet style, since the score skips it. */
  mark.hl.hl-quote { background: transparent; color: var(--ink-soft); box-shadow: none; border-bottom: 1px dashed var(--ink-soft); border-radius: 0; animation: none; }
  .legend .hl-quote { background: transparent; border: 1px dashed var(--ink-soft); }
  mark.hl { color: inherit; border-radius: 4px; padding: 1px 0; box-shadow: inset 0 -2px 0 var(--line); cursor: help; animation: markIn 0.6s var(--ease) backwards; }
  @keyframes markIn { from { background: transparent; box-shadow: inset 0 0 0 transparent; } }
  mark.hid { background: var(--bad); color: var(--bg); font-family: var(--mono); font-size: 11px; padding: 1px 5px; border-radius: 5px; margin: 0 1px; vertical-align: 1px; cursor: help; }
  mark.hid-letter { background: transparent; color: var(--bad); font: inherit; font-size: inherit; padding: 0; margin: 0; box-shadow: inset 0 -2px 0 var(--bad); vertical-align: baseline; }
  .hl-tip { position: absolute; z-index: 50; max-width: min(320px, calc(100vw - 16px)); padding: 6px 10px; border-radius: 8px; background: var(--ink); color: var(--bg); font-size: 13px; line-height: 1.4; box-shadow: 0 6px 20px rgba(0,0,0,0.25); pointer-events: none; }
  .hl-tip[hidden] { display: none; }
  mark.hl, mark.hid { cursor: pointer; }
  /* The full text of the pattern under the pointer or the last click. */
  mark.hl.active { outline: 2px solid var(--ink); outline-offset: 1px; }
  mark.hl:focus-visible, mark.hid:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
  mark.hid.active { outline: 2px solid var(--bad); outline-offset: 1px; }
  .summary-line { font-weight: 600; }
  .next { text-align: center; margin: 80px auto 0; max-width: 720px; }
</style>

<script>
  import { onStatus, load, analyze, highlight, showHidden, groupOf, type Analysis } from "../../../scripts/titus";
  import { setRing } from "../../../scripts/ring";
  import { copyText, toast } from "../../../scripts/site";
  import { initTabs } from "../../../scripts/tabs";

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const input = $<HTMLTextAreaElement>("input");
  const run = $<HTMLButtonElement>("run");
  const status = $("status");
  let last: Analysis | null = null;
  let original = "";
  let view = "patterns";

  const SAMPLE = "In today’s fast-paced digital landscape, our new onboarding checklist isn’t just a tracker — it’s a gateway to a more seamless experience, fostering alignment and driving meaningful impact. Moreover, it serves as a pivotal tool for every team​ member. The checklist was designed to empower new hires to navigate the process with confidence. Experts say that clear onboarding plays a crucial role in retention. One new hire wrote, \"The checklist is a game-changer — I knew exactly what to do on day one.\" Additionally, it leverages robust automation to unlock value acrоss departments. Ultimately, this is not only a checklist but a testament to our commitment to people. I hope this helps, and let me know if you have any questions!";

  const words = (t: string) => (t.match(/[A-Za-z0-9À-ɏ']+/g) || []).length;
  input.addEventListener("input", () => { $("count").textContent = `${words(input.value)} words`; });

  // Python (about 12 MB) downloads only once the visitor shows they want to check something:
  // focusing or typing in the box, or pressing a button.
  const mb = (n: number) => (n / 1e6).toFixed(1);
  onStatus((s) => {
    status.dataset.state = s.ready ? "ready" : s.failed ? "failed" : s.started ? "loading" : "idle";
    status.querySelector(".status-text")!.textContent = s.ready ? "Ready" : s.failed ? "Could not load Python" : s.started ? s.text : "The first check downloads Python, about 12 MB";
    const showBar = s.started && !s.ready && !s.failed && s.total > 0;
    $("load").hidden = !showBar;
    if (showBar) {
      ($("load-bar") as HTMLProgressElement).value = s.loaded / s.total;
      $("load-text").textContent = s.loaded < s.total ? `${mb(s.loaded)} of ${mb(s.total)} MB` : "Starting Python";
    }
  });
  input.addEventListener("focus", load, { once: true });
  input.addEventListener("input", load, { once: true });

  function render() {
    if (!last) return;
    const el = $("view");
    const legend = $("legend");
    legend.hidden = view !== "patterns";
    if (view === "patterns") {
      const quoteSpans = last.quotes.map((q) => ({ ...q, label: "quoted text", weight: 0 }));
      el.innerHTML = highlight(last.cleaned, [...last.spans, ...quoteSpans]);
      const notes = [last.spans.length ? "Hover over, click or tap a highlight to see the pattern's name. With a keyboard, press Tab to move between highlights." : "No patterns to highlight."];
      if (last.quotes.length) notes.push("Quoted text has a dashed underline. It stays as written, so nothing inside it is marked.");
      $("view-note").textContent = notes.join(" ");
    } else if (view === "hidden") {
      el.innerHTML = last.hidden.length ? showHidden(original, last.hidden) : "";
      $("view-note").textContent = last.hidden.length ? "Red badges show where each hidden character was. Underlined letters were look-alikes from another alphabet." : "No hidden characters found.";
    } else {
      el.textContent = last.cleaned;
      $("view-note").textContent = "This is your text with the hidden characters removed. Patterns are left for you or a rewrite to fix.";
    }
  }

  async function check() {
    original = input.value;
    if (!original.trim()) { toast("Paste some text first"); return; }
    run.disabled = true;
    run.textContent = "Checking";
    try {
      last = await analyze(original);
    } catch (e) {
      toast("Something went wrong. Try again.");
      console.error(e);
      return;
    } finally {
      run.disabled = false;
      run.textContent = "Check text";
    }
    const r = last.score;
    const results = $("results");
    const first = results.hidden;
    results.hidden = false;
    if (first) results.scrollIntoView({ behavior: "smooth", block: "start" });
    setRing("ring", r.score, r.tier, r.score === null ? `Needs ${last.min_words}+ words` : undefined);
    $("s-words").textContent = String(r.words);
    $("s-sents").textContent = String(r.sentences);
    $("s-density").textContent = r.density != null ? String(r.density) : "--";
    const hiddenTotal = Object.values(last.found).reduce((a, b) => a + b, 0);
    $("s-hidden").textContent = String(hiddenTotal);
    $("s-note").textContent = r.score === null
      ? `The text has ${r.words} words. The score needs at least ${last.min_words}, so only the patterns are listed.`
      : r.dampened ? "The text is short, so the score is dampened and less reliable." : "Scores of 0.60 and up count as high. Under 0.35 counts as low.";
    const list = $("patterns");
    list.innerHTML = "";
    if (!r.patterns.length) {
      list.innerHTML = `<li class="empty-row">No patterns found.</li>`;
    } else {
      [...r.patterns].sort((a, b) => b.count - a.count).forEach((p, i) => {
        const li = document.createElement("li");
        li.style.animationDelay = `${0.05 * i}s`;
        const g = groupOf(p.label);
        li.innerHTML = `<span class="chip" style="background: var(--hl-${g}-line)"></span><span><span class="name"></span><span class="eg"></span></span><span class="count">x${p.count}</span>`;
        li.querySelector(".name")!.textContent = p.label;
        li.querySelector(".eg")!.textContent = `e.g. "${p.sample.replace(/^[\s.!?]+/, "").slice(0, 60)}"`;
        list.appendChild(li);
      });
    }
    const nq = last.quotes.length;
    const qs = $("quote-summary");
    qs.textContent = nq ? `Quoted text: ${nq} ${nq === 1 ? "quotation" : "quotations"} left as written and not scored.` : "Quoted text: none.";
    $("hidden-summary").textContent = `Hidden characters removed: ${last.found_text}.`;
    selectView("patterns");
    announce(r.score === null
      ? `Not scored. The text has ${r.words} words and the score needs at least ${last.min_words}. ${typesText(r.patterns.length)}`
      : `Score ${r.score.toFixed(2)}, ${r.tier}. ${typesText(r.patterns.length)}${hiddenTotal ? ` ${hiddenTotal} hidden ${hiddenTotal === 1 ? "character" : "characters"} removed.` : ""}`);
  }

  // A short summary for screen readers, since the results appear without moving focus.
  function typesText(n: number) {
    return n ? `${n} pattern ${n === 1 ? "type" : "types"} found.` : "No patterns found.";
  }
  function announce(text: string) {
    const live = $("announce");
    live.textContent = "";
    setTimeout(() => { live.textContent = text; }, 50);
  }

  const actions = ["run", "sample", "clear"].map((id) => $(id));
  actions.forEach((b) => b.addEventListener("click", () => actions.forEach((x) => x.classList.toggle("picked", x === b))));
  run.addEventListener("click", check);
  input.addEventListener("keydown", (e) => { if ((e.metaKey || e.ctrlKey) && e.key === "Enter" && !run.disabled) check(); });
  $("sample").addEventListener("click", () => { input.value = SAMPLE; input.dispatchEvent(new Event("input")); check(); });
  $("clear").addEventListener("click", () => { input.value = ""; input.dispatchEvent(new Event("input")); $("results").hidden = true; input.focus(); });
  $("copy-clean").addEventListener("click", () => last && copyText(last.cleaned, "Cleaned text copied"));
  // Hovering over a highlight, or clicking or tapping it, shows the pattern's name in a small label
  // and outlines the exact text that pattern matched. A click keeps it open until the next click.
  // Highlights are focusable buttons too: Tab shows the label, Enter or Space keeps it open,
  // and Escape closes it. The label is tied to the focused highlight with aria-describedby.
  const tip = document.createElement("div");
  tip.className = "hl-tip";
  tip.id = "hl-tip";
  tip.setAttribute("role", "tooltip");
  tip.hidden = true;
  document.body.appendChild(tip);
  let pinned: HTMLElement | null = null;
  const viewEl = $("view");
  const clearActive = () => viewEl.querySelectorAll("mark.active").forEach((x) => x.classList.remove("active"));
  const hideTip = () => {
    tip.hidden = true; pinned = null; clearActive();
    viewEl.querySelectorAll("[aria-describedby='hl-tip']").forEach((x) => x.removeAttribute("aria-describedby"));
  };
  const markAt = (t: EventTarget | null) => (t as HTMLElement | null)?.closest?.<HTMLElement>("mark.hl, mark.hid") || null;
  function showTip(m: HTMLElement, clientY: number) {
    clearActive();
    const id = m.dataset.span;
    const parts = id != null ? viewEl.querySelectorAll<HTMLElement>(`mark.hl[data-span="${id}"]`) : [m];
    parts.forEach((x) => x.classList.add("active"));
    viewEl.querySelectorAll("[aria-describedby='hl-tip']").forEach((x) => x.removeAttribute("aria-describedby"));
    m.setAttribute("aria-describedby", "hl-tip");
    tip.textContent = m.dataset.label || "";
    tip.hidden = false;
    // A highlight that wraps has one box per line, so use the line under the pointer.
    const rects = [...m.getClientRects()];
    const r = rects.find((b) => clientY >= b.top && clientY <= b.bottom) || rects[0] || m.getBoundingClientRect();
    const left = Math.min(Math.max(8, r.left + window.scrollX), window.scrollX + document.documentElement.clientWidth - tip.offsetWidth - 8);
    // Go above the line, unless that would put the label under the sticky menus or the top of the view.
    const covered = Math.max(0, ...[...document.querySelectorAll(".nav, .subnav")].map((n) => n.getBoundingClientRect().bottom));
    const floor = Math.max(covered, viewEl.getBoundingClientRect().top);
    const above = r.top - tip.offsetHeight - 8;
    const top = above >= floor ? above : r.bottom + 8;
    tip.style.left = `${left}px`;
    tip.style.top = `${top + window.scrollY}px`;
  }
  viewEl.addEventListener("mouseover", (e) => { const m = markAt(e.target); if (m && !pinned) showTip(m, e.clientY); });
  viewEl.addEventListener("mouseout", (e) => {
    const m = markAt(e.target);
    if (m && !pinned && markAt(e.relatedTarget)?.dataset.span !== m.dataset.span) { tip.hidden = true; clearActive(); }
  });
  viewEl.addEventListener("click", (e) => {
    const m = markAt(e.target);
    if (!m || m === pinned) { hideTip(); return; }
    e.stopPropagation();
    showTip(m, e.clientY);
    pinned = m;
  });
  const middle = (m: HTMLElement) => { const r = m.getClientRects()[0] || m.getBoundingClientRect(); return r.top + r.height / 2; };
  viewEl.addEventListener("focusin", (e) => { const m = markAt(e.target); if (m && pinned !== m) { pinned = null; showTip(m, middle(m)); } });
  viewEl.addEventListener("focusout", (e) => { if (!pinned && !markAt(e.relatedTarget)) hideTip(); });
  viewEl.addEventListener("keydown", (e) => {
    const m = markAt(e.target);
    if (e.key === "Escape") { hideTip(); return; }
    if (!m || (e.key !== "Enter" && e.key !== " ")) return;
    e.preventDefault();
    if (pinned === m) { pinned = null; tip.hidden = true; clearActive(); }
    else { showTip(m, middle(m)); pinned = m; }
  });
  document.addEventListener("click", (e) => { if (!$("view").contains(e.target as Node)) hideTip(); });
  viewEl.addEventListener("scroll", hideTip);
  window.addEventListener("resize", hideTip);

  // Each new check opens on Highlighted patterns. The other tabs show when clicked.
  const viewTabs = initTabs(document.querySelector<HTMLElement>('[aria-label="View"]')!, (b) => {
    view = b.dataset.view!;
    viewEl.setAttribute("aria-labelledby", b.id);
    hideTip();
    render();
  });
  function selectView(name: string) {
    viewTabs.select(viewTabs.tabs.find((t) => t.dataset.view === name)!);
  }
</script>

<style is:global>
  /* Check text, Try a sample and Clear start as matching outlines. The last one clicked fills in. */
  .checker-actions .btn.picked { background: var(--accent); color: var(--accent-ink); box-shadow: none; }
  /* The selected view tab is filled. Highlighted patterns starts selected. */
  .legend[hidden] { display: none; }
