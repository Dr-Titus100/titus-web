---
import Base from "../../layouts/Base.astro";
import { u } from "../../lib/url";
import { tools } from "../../data/tools";
---
<Base title="Tools" current="tools" description="Skills, plugins and games by Titus Nyarko Nde, each free to try on this site.">
  <section class="hero">
    <div class="wrap wrap-text">
      <h1 class="h1">Tools</h1>
      <p class="lead">Skills and plugins for Claude, ChatGPT and other assistants, and a game. Each one is free to try on this site.</p>
    </div>
  </section>
  <section class="tools-list">
    <div class="wrap">
      {tools.map((t) => (
        <article class="card tool-feature reveal">
          <div class="tool-text">
            <p class="small muted tool-kind">{t.kind}<br />Version {t.version.replace(/^v/, "")}</p>
            <h2 class="h-tile"><a class="tool-link" href={u(t.href)}>{t.name}</a></h2>
            <p class="muted">{t.blurb}</p>
            <div class="btn-row">
              <a class="btn" href={u(t.links[0].href)}>{t.cta}</a>
              <a class="btn" href={t.more.href.startsWith("http") ? t.more.href : u(t.more.href)}>{t.more.label}</a>
            </div>
          </div>
          <picture class="tool-shot">
            <source srcset={u(t.image.webp)} type="image/webp" />
            <img src={u(t.image.jpg)} alt={t.image.alt} width={t.image.width} height={t.image.height} loading="lazy" decoding="async" />
          </picture>
        </article>
      ))}
    </div>
  </section>
</Base>
<style>
  .tools-list { padding: 0 0 120px; }
  .tool-feature { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 48px; align-items: center; padding: 56px; }
  /* The title's link covers the whole card, so a click anywhere on it opens the tool's page. The buttons sit above it. */
  .tool-feature { position: relative; }
  .tool-feature:hover { border-color: var(--line); cursor: pointer; }
  .tool-link { color: inherit; }
  .tool-link:hover { text-decoration: none; }
  .tool-link::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .tool-link:focus-visible { outline: none; }
  .tool-link:focus-visible::after { outline: 2px solid var(--accent); outline-offset: -4px; }
  .tool-text .btn-row { position: relative; z-index: 1; }
  .tool-text { display: flex; flex-direction: column; gap: 12px; }
  .tool-text p, .tool-text h2 { margin: 0; }
  .tool-text .btn-row { margin-top: 12px; }
  .tool-shot img { width: 100%; height: auto; border-radius: 14px; border: 1px solid var(--line-soft); }
  @media (max-width: 1068px) { .tools-list { padding-bottom: 80px; } .tool-feature { grid-template-columns: 1fr; padding: 40px; } }
  @media (max-width: 734px) { .tools-list { padding-bottom: 64px; } .tool-feature { padding: 28px 20px; gap: 28px; } }
</style>
