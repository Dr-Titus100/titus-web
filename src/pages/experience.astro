---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url";
import { links, roles, education, publications, talks, leadership, awards, skills } from "../data/profile";

const filters = [
  { id: "all", name: "All" },
  { id: "ai", name: "AI" },
  { id: "research", name: "Research" },
  { id: "industry", name: "Industry" },
  { id: "teaching", name: "Teaching" },
];
const tagName = { ai: "AI", research: "Research", industry: "Industry", teaching: "Teaching" };
---
<Base title="Experience" current="experience" description="Titus Nyarko Nde's work in AI evaluation, machine learning research, banking analytics and research computing, with his education, publications and talks.">
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="wrap wrap-narrow">
      <p class="eyebrow">Experience</p>
      <h1 class="h1" data-rise>Machine learning, research and AI evaluation</h1>
      <p class="lead">I've built credit and churn models for lenders, measured uncertainty in galaxy cluster masses and satellite maps, and graded and written training data for large language models. Now I also write AI skills, starting with titus-humanizer.</p>
      <div class="btn-row">
        <a class="btn" href={links.linkedin}>LinkedIn</a>
        <a class="btn btn-ghost" href={links.scholar}>Google Scholar</a>
        <a class="btn btn-ghost" href={links.github}>GitHub</a>
      </div>
    </div>
  </section>

  <section class="section-tight" style="padding-top: 0">
    <div class="wrap">
      <div class="stats reveal">
        <div><strong>0.986</strong><span>AUC of the churn model KCB Bank Rwanda adopted</span></div>
        <div><strong>100+</strong><span>citations of the micro-credit scoring paper in Risks</span></div>
        <div><strong>250+</strong><span>LLM evaluation tasks graded at Mercor</span></div>
        <div><strong>20 m</strong><span>albedo maps downscaled from 2 km at Berkeley Lab</span></div>
      </div>
    </div>
  </section>

  <section class="section" id="work">
    <div class="wrap wrap-narrow">
      <div class="section-head">
        <h2 class="h2">Work</h2>
      </div>
      <div class="center" style="margin-bottom: 36px">
        <div class="segmented" role="group" aria-label="Filter roles">
          {filters.map((f, i) => <button type="button" aria-pressed={i === 0 ? "true" : "false"} data-filter={f.id}>{f.name}</button>)}
        </div>
      </div>
      <ol class="timeline">
        {roles.map((r) => (
          <li class="role reveal" data-tag={r.tag}>
            <div class="role-when">
              <span class="role-dates">{r.dates}</span>
              <span class={`role-tag tag-${r.tag}`}>{tagName[r.tag]}</span>
            </div>
            <div class="card role-card">
              <h3 class="h3">{r.title}</h3>
              <p class="role-org">{r.orgUrl ? <a href={r.orgUrl}>{r.org}</a> : r.org}<span class="muted">, {r.place}</span></p>
              <ul class="role-points">
                {r.points.map((p) => <li>{p}</li>)}
              </ul>
              {r.tag === "ai" && r.org === "Independent project" && (
                <div class="btn-row" style="margin-top: 18px">
                  <a class="btn btn-small" href={u("/tools/titus-humanizer/")}>Try titus-humanizer</a>
                  <a class="btn btn-small btn-quiet" href={r.orgUrl}>Source on GitHub</a>
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section-soft" id="education">
    <div class="wrap wrap-narrow">
      <div class="section-head"><h2 class="h2">Education</h2></div>
      <div class="stack">
        {education.map((e, i) => (
          <div class="card reveal" style={`--d: ${i * 0.06}s`}>
            <div class="row-head"><h3 class="h3">{e.degree}</h3><span class="muted small">{e.date}</span></div>
            <p class="role-org">{e.school}</p>
            {e.notes.map((n) => <p class="muted" style="margin: 6px 0 0">{n}</p>)}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="publications">
    <div class="wrap wrap-narrow">
      <div class="section-head">
        <h2 class="h2">Publications</h2>
        <p class="lead">The full list is on <a href={links.scholar}>Google Scholar</a> and <a href={links.orcid}>ORCID</a>.</p>
      </div>
      <ol class="pubs">
        {publications.map((p) => (
          <li class="reveal">
            <p>{p.cite}</p>
            {p.url && <a class="link-arrow small" href={p.url}>{p.label}</a>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section-soft" id="talks">
    <div class="wrap">
      <div class="grid grid-2 two-lists">
        <div>
          <h2 class="h3" style="margin-bottom: 18px">Talks, posters and workshops</h2>
          <ul class="dated">
            {talks.map(([d, t]) => <li><span class="muted small">{d}</span><span>{t}</span></li>)}
          </ul>
        </div>
        <div>
          <h2 class="h3" style="margin-bottom: 18px">Awards and certificates</h2>
          <ul class="dated">
            {awards.map(([d, t]) => <li><span class="muted small">{d}</span><span>{t}</span></li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="leadership">
    <div class="wrap wrap-narrow">
      <div class="section-head"><h2 class="h2">Teaching, outreach and leadership</h2></div>
      <div class="stack">
        {leadership.map(([role, org, text], i) => (
          <div class="card reveal" style={`--d: ${i * 0.05}s`}>
            <h3 class="h3" style="font-size: 19px">{org}</h3>
            <p class="muted" style="margin: 6px 0 0">{role}</p>
            {text && <p style="margin: 12px 0 0">{text}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-dark" id="skills">
    <div class="wrap wrap-narrow">
      <div class="section-head"><h2 class="h2">Skills and tools</h2></div>
      <dl class="skills">
        {skills.map(([k, v]) => <div class="reveal"><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap center">
      <h2 class="h2 reveal">More about me</h2>
      <div class="btn-row center reveal" style="margin-top: 24px">
        <a class="btn" href={u("/about/")}>About</a>
        <a class="btn btn-ghost" href={u("/tools/")}>Skills and tools I've built</a>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .stats > div { background: var(--bg-soft); border-radius: 22px; padding: 26px 22px; display: flex; flex-direction: column; gap: 8px; }
  .stats strong { font-size: clamp(32px, 4vw, 44px); letter-spacing: -0.03em; line-height: 1; }
  .stats span { color: var(--ink-soft); font-size: 15px; line-height: 1.4; }
  @media (max-width: 860px) { .stats { grid-template-columns: repeat(2, 1fr); } }

  .timeline { list-style: none; margin: 0; padding: 0; position: relative; }
  .timeline::before { content: ""; position: absolute; left: 172px; top: 8px; bottom: 8px; width: 2px; background: linear-gradient(var(--accent), transparent); opacity: 0.35; }
  .role { display: grid; grid-template-columns: 150px 1fr; gap: 44px; margin-bottom: 28px; position: relative; }
  .role::before { content: ""; position: absolute; left: 166px; top: 28px; width: 14px; height: 14px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 20%, transparent); }
  .role[hidden] { display: none; }
  .role-when { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; padding-top: 24px; text-align: right; }
  .role-dates { font-size: 14px; font-weight: 600; }
  .role-tag { font-size: 12px; font-weight: 600; padding: 3px 10px; border-radius: 999px; background: rgba(127,127,127,0.12); }
  .tag-ai { color: #7c3aed; background: rgba(124,58,237,0.12); }
  .tag-research { color: #0a84ff; background: rgba(10,132,255,0.12); }
  .tag-industry { color: #c2410c; background: rgba(234,88,12,0.12); }
  .tag-teaching { color: #15803d; background: rgba(22,163,74,0.12); }
  .role-card h3 { margin: 0; }
  .role-org { margin: 6px 0 0; font-weight: 500; }
  .role-points { margin: 16px 0 0; padding-left: 1.1em; display: flex; flex-direction: column; gap: 10px; }
  .role-points li { line-height: 1.55; }
  .role.enter { animation: roleIn 0.5s var(--ease) both; }
  @keyframes roleIn { from { opacity: 0; transform: translateY(14px); } }
  @media (max-width: 720px) {
    .timeline::before { left: 6px; }
    .role { grid-template-columns: 1fr; gap: 10px; padding-left: 28px; }
    .role::before { left: 0; top: 4px; }
    .role-when { flex-direction: row; align-items: center; padding-top: 0; text-align: left; }
  }

  .stack { display: flex; flex-direction: column; gap: 16px; }
  .row-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; }
  .row-head h3 { margin: 0; }

  .pubs { margin: 0; padding-left: 1.2em; display: flex; flex-direction: column; gap: 22px; }
  .pubs p { margin: 0 0 6px; line-height: 1.55; }

  .two-lists { align-items: start; }
  .dated { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .dated li { display: grid; grid-template-columns: 82px 1fr; gap: 14px; padding: 12px 0; border-top: 1px solid var(--line-soft); line-height: 1.45; }
  .dated li span:first-child { padding-top: 2px; }

  .skills { margin: 0; display: flex; flex-direction: column; }
  .skills > div { display: grid; grid-template-columns: 200px 1fr; gap: 20px; padding: 18px 0; border-top: 1px solid rgba(255,255,255,0.14); }
  .skills dt { font-weight: 600; }
  .skills dd { margin: 0; opacity: 0.8; line-height: 1.55; }
  @media (max-width: 640px) { .skills > div { grid-template-columns: 1fr; gap: 6px; } }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  buttons.forEach((b) => b.addEventListener("click", () => {
    buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    const f = b.dataset.filter;
    document.querySelectorAll<HTMLElement>(".role").forEach((r) => {
      const show = f === "all" || r.dataset.tag === f;
      r.hidden = !show;
      r.classList.remove("enter");
      if (show) { void r.offsetWidth; r.classList.add("enter"); r.classList.add("in"); }
    });
  }));
</script>
