---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url";
import { links } from "../data/profile";
import ContactForm from "../components/ContactForm.astro";

const person = {
  "@type": "Person",
  name: "Titus Nyarko Nde",
  jobTitle: "Data scientist",
  url: new URL(u("/about/"), Astro.site).href,
  image: new URL(u("/images/titus.jpg"), Astro.site).href,
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "Boise State University" },
    { "@type": "EducationalOrganization", name: "African Institute for Mathematical Sciences" },
    { "@type": "CollegeOrUniversity", name: "University for Development Studies" },
  ],
  sameAs: [links.linkedin, links.scholar, links.orcid, links.github],
};

const chapters = [
  {
    when: "2026 to now",
    where: "Remote",
    title: "AI evaluation and AI skills",
    text: "Since March 2026 I've trained and evaluated large language models for Outlier AI and Mercor. I grade model writing against detailed rubrics, write benchmark tasks and correct failed agent runs. That grading taught me which patterns give AI writing away, so I wrote the rules down as titus-humanizer, a skill that rewrites text in plain words and scores what's left. This site is where I publish it and the skills that follow.",
  },
  {
    when: "2021 to 2026",
    where: "Boise, Idaho",
    title: "A Ph.D. on uncertainty",
    text: "My Ph.D. in Computing at Boise State University asked how much we can trust a model's answer in three different systems: the masses of galaxy clusters, the height of dryland vegetation and the albedo of mountain snow. I spent summer 2025 at Lawrence Berkeley National Laboratory on the albedo work. For my last two years I also worked in Research Computing, teaching students and faculty to use the Borah supercomputer.",
  },
  {
    when: "2019 to 2021",
    where: "Kigali, Rwanda",
    title: "Credit risk and banking",
    text: "A Mastercard Foundation scholarship took me to the African Institute for Mathematical Sciences (AIMS) for a master's in mathematical sciences. For my thesis I worked with a microfinance lender in Ghana on credit risk. The lender's credit team adopted the scoring model we built, and the paper on it in Risks has more than 100 citations. I also worked as a data analyst at KCB Bank Rwanda, where I built a churn model and the R and Python tools that the customer service, operations, credit risk and HR teams used.",
  },
  {
    when: "2014 to 2018",
    where: "Tamale, Ghana",
    title: "Actuarial science",
    text: "I studied Actuarial Science at the University for Development Studies and graduated with first-class honors. My undergraduate thesis modeled and forecast rainfall in the Tamale Metropolitan Assembly, and in 2018 I received the Prudential Actuarial Support Scheme award.",
  },
];
---
<Base title="About" current="about" image="/og/about.png" imageAlt="Titus Nyarko Nde" type="profile" jsonLd={person} description="Titus Nyarko Nde is a data scientist with a Ph.D. in Computing from Boise State University. He works on machine learning uncertainty, AI evaluation and AI writing tools.">
  <section class="hero about-hero">
    <div class="wrap wrap-text">
      <img class="portrait" src={u("/images/titus.jpg")} alt="Titus Nyarko Nde" width="200" height="200" />
      <p class="eyebrow">About</p>
      <h1 class="display">Titus Nyarko Nde</h1>
      <p class="lead">I'm a data scientist with a Ph.D. in Computing from Boise State University. I build machine learning models, work out how far to trust their answers, and write tools that help people write clearly with AI.</p>
      <div class="btn-row">
        <a class="btn" href="#contact">Contact me</a>
        <a class="link-arrow" href={u("/experience/")}>See my experience</a>
        <a class="link-arrow" href={u("/tools/")}>Skills I've built</a>
      </div>
    </div>
  </section>

  <section class="section section-soft" id="path">
    <div class="wrap wrap-text">
      <p class="eyebrow">How I got here</p>
      <h2 class="h2 path-title">From my AI work today back to Tamale</h2>
      <ol class="chapters">
        {chapters.map((c, i) => (
          <li class="chapter reveal" style={`--d: ${i * 0.04}s`}>
            <div class="chapter-when">
              <span class="chapter-year">{c.when}</span>
              <span class="muted small">{c.where}</span>
            </div>
            <div>
              <h3 class="h3">{c.title}</h3>
              <p>{c.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="focus">
    <div class="wrap">
      <h2 class="h2 center focus-title">What I work on</h2>
      <div class="grid grid-2">
        <div class="card tile span-2 reveal">
          <h3 class="h-tile">Uncertainty in machine learning</h3>
          <p class="focus-wide">Bayesian inference, MCMC and ensembles that say how much to trust a prediction. I've applied them to galaxy cluster masses, vegetation height from satellite lasers and 20 m snow albedo maps.</p>
        </div>
        <div class="card tile reveal">
          <h3 class="h-tile">AI writing and evaluation</h3>
          <p>Rubric grading, benchmark tasks with Python verifiers, and AI skills such as titus-humanizer that make model output clearer and easier to check.</p>
          <a class="link-arrow" href={u("/tools/titus-humanizer/")}>Learn about titus-humanizer</a>
        </div>
        <div class="card tile reveal" style="--d: 0.06s">
          <h3 class="h-tile">Teaching computing</h3>
          <p>I co-founded the Center for Computational Research and Education, which runs a six-week online HPC training and research program each year for students and early-career researchers in Africa.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-soft" id="community">
    <div class="wrap wrap-text center">
      <h2 class="h2">Outside the lab</h2>
      <p class="lead community-text">At Boise State I led the SIAM student chapter as president, served as vice president of the International Students Association, mentored new international students and volunteered at STEM nights for elementary schools and refugee families. In December 2025 the university gave me the Bronco Spirit Award for academic excellence and leadership.</p>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="wrap wrap-narrow">
      <div class="section-head">
        <p class="eyebrow">Contact</p>
        <h2 class="h2">Write to me</h2>
        <p class="lead">Send a message here and it comes straight to my inbox. I reply from my own email.</p>
      </div>
      <ContactForm />
    </div>
  </section>

  <section class="section-tight section-soft" id="links">
    <div class="wrap wrap-text">
      <h2 class="h-tile center links-title">Find me online</h2>
      <div class="link-grid">
        <a class="card link-card" href={links.linkedin}>
          <svg class="tile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
          <span class="h4">LinkedIn</span><span class="small muted">Work history</span><span class="link-arrow small">Visit</span>
        </a>
        <a class="card link-card" href={links.github}>
          <svg class="tile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 7l-5 5 5 5M16 7l5 5-5 5" /></svg>
          <span class="h4">GitHub</span><span class="small muted">titus-humanizer and this site</span><span class="link-arrow small">Visit</span>
        </a>
        <a class="card link-card" href={links.scholar}>
          <svg class="tile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h6a2 2 0 0 1 2 2v13a2 2 0 0 0-2-2H4zM20 5h-6a2 2 0 0 0-2 2v13a2 2 0 0 1 2-2h6z" /></svg>
          <span class="h4">Google Scholar</span><span class="small muted">Papers and citations</span><span class="link-arrow small">Visit</span>
        </a>
        <a class="card link-card" href={links.orcid}>
          <svg class="tile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="9" cy="11" r="2.5" /><path d="M5.5 17c.8-2 2-3 3.5-3s2.7 1 3.5 3M15 9h3M15 13h3" /></svg>
          <span class="h4">ORCID</span><span class="small muted">Research record</span><span class="link-arrow small">Visit</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  .about-hero .portrait { display: block; width: 200px; height: 200px; margin: 0 auto 32px; border-radius: 50%; object-fit: cover; }
  .about-hero .eyebrow { margin-bottom: 8px; }
  .path-title { max-width: 760px; margin: 0 0 48px; }
  .chapters { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .chapter { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 40px; padding: 32px 0; border-top: 1px solid var(--line); }
  .chapter:last-child { border-bottom: 1px solid var(--line); }
  .chapter-when { display: flex; flex-direction: column; gap: 4px; }
  .chapter-year { font-weight: 600; font-size: 21px; }
  .chapter h3 { margin: 0 0 8px; }
  .chapter p { margin: 0; line-height: 1.6; color: var(--ink-mid); }
  .focus-title { margin-bottom: 48px; }
  .focus-wide { max-width: 760px; }
  .community-text { max-width: 760px; margin: 24px auto 0; }
  .links-title { margin-bottom: 32px; }
  .link-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .link-card { display: flex; flex-direction: column; gap: 8px; padding: 28px 24px; border-radius: var(--radius); color: var(--ink); }
  .link-card:hover { text-decoration: none; }
  .link-card:hover .link-arrow { text-decoration: underline; }
  .link-card .link-arrow { margin-top: auto; padding-top: 8px; }
  @media (max-width: 1068px) { .link-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 734px) {
    .about-hero .portrait { width: 144px; height: 144px; margin-bottom: 24px; }
    .path-title, .focus-title { margin-bottom: 32px; }
    .chapter { grid-template-columns: 1fr; gap: 8px; padding: 24px 0; }
    .link-grid { grid-template-columns: 1fr 1fr; gap: 12px; }
    .link-card { padding: 20px 16px; }
  }
</style>
