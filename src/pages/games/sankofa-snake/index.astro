---
import Base from "../../../layouts/Base.astro";
import { u } from "../../../lib/url";
import games from "../../../data/games.generated.json";
const game = games["sankofa-snake"];
const version = game.version.replace(/^v/, "");
const app = {
  "@type": "VideoGame",
  name: "Sankofa Snake",
  description: "A snake game in kente colors. Guide a snake of woven kente blocks to collect cowrie shells, with a new world and a new challenge in each level.",
  url: new URL(u("/games/sankofa-snake/"), Astro.site).href,
  applicationCategory: "GameApplication",
  gamePlatform: "Web browser",
  softwareVersion: version,
  license: "https://opensource.org/licenses/MIT",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Person", name: "Titus Nyarko Nde", url: new URL(u("/about/"), Astro.site).href },
  sameAs: [game.repoUrl],
};
---
<Base title="Sankofa Snake" current="tools" jsonLd={app} description="Sankofa Snake is a free snake game in kente colors. Guide a snake of woven kente blocks to collect cowrie shells, with a new world and a new challenge in each level.">
  <link rel="stylesheet" href={u("/games/sankofa-snake/sankofa-snake.css")} />

  <section class="hero game-hero">
    <div class="wrap wrap-text">
      <p class="eyebrow">Sankofa Snake {version}</p>
      <h1 class="h1">Sankofa Snake</h1>
      <p class="lead">Guide a snake of woven kente blocks to collect cowrie shells. Each level is a new world with a new challenge.</p>
    </div>
  </section>

  <section class="game-section">
    <div class="wrap">
      <div data-sankofa-snake></div>
      <noscript><p class="center muted">The game needs JavaScript to run.</p></noscript>
    </div>
  </section>

  <section class="section section-soft">
    <div class="wrap wrap-text game-about">
      <h2 class="h2">About the game</h2>
      <p>The first three worlds are open now. The Farm teaches the controls, the Park speeds the snake up after every 5 cowries, and the Market fills the board with stalls to steer around. Eat 20 cowries to clear a level and unlock the next one. City, Road, Lab, Maze, Ocean and the Weaving village come next, along with a daily challenge, power-ups and sound.</p>
      <p>The logo is the Sankofa bird, an Adinkra symbol from Ghana. The bird turns back to pick up an egg from its back, and the Akan word means "go back and get it." The kente patterns and the bird are drawn in code for this game.</p>
      <p>Your scores and stars stay in your browser. The game sends nothing anywhere and has no ads.</p>
      <p>The game is open source under the MIT license. The code, the level files and the tests are on <a href={game.repoUrl}>GitHub</a>, and this page runs <a href={game.releaseUrl}>release {version}</a>.</p>
    </div>
  </section>

  <script is:inline type="module" src={u("/games/sankofa-snake/sankofa-snake.js")}></script>
</Base>
<style>
  .game-hero { padding-bottom: 32px; }
  .game-section { padding: 0 0 80px; }
  .game-about p { font-size: 19px; line-height: 1.55; margin: 20px 0 0; }
  .game-about h2 { margin-bottom: 8px; }
  @media (max-width: 734px) {
    .game-hero { padding-bottom: 20px; }
    .game-section { padding-bottom: 56px; }
    .game-section .wrap { padding-left: 8px; padding-right: 8px; }
  }
</style>
