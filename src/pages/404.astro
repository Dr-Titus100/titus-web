---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url";
---
<Base title="Page not found">
  <section class="section empty">
    <div class="wrap wrap-narrow">
      <h1 class="h1">This page isn't here.</h1>
      <p class="lead">The link may be old, or the page may have moved.</p>
      <div class="btn-row center not-found-actions"><a class="btn" href={u("/")}>Go to the home page</a></div>
    </div>
  </section>
</Base>
<style>.not-found-actions { margin-top: 32px; }</style>
